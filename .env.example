# Copy to .env (ignored by git) and adjust. Every setting can also be passed
# as a regular environment variable. See README.md "Configuration".

# --- Django ---
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# ... or a file containing it
#DJANGO_SECRET_KEY_FILE=/srv/django-blast/secret_key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
#DJANGO_CSRF_TRUSTED_ORIGINS=https://blast.example.org
#DJANGO_TIME_ZONE=America/New_York
#DJANGO_ADMINS=admin@example.org
# scheme and host for the links in e-mails (without a URL prefix)
#DJANGO_SITE_URL=https://blast.example.org
#DJANGO_LOGIN_URL=login
#DJANGO_LOGIN_REDIRECT_URL=dashboard
#DJANGO_LOG_LEVEL=WARNING

# --- Database (default: SQLite file db.sqlite3 in the project root) ---
#DATABASE_URL=postgres://django:password@127.0.0.1:5432/django_i5k
#DATABASE_CONN_MAX_AGE=0

# --- Files ---
#DJANGO_MEDIA_ROOT=/srv/django-blast/media
#DJANGO_MEDIA_URL=/media/
#DJANGO_MEDIA_UPLOAD_MAX_SIZE=10737418240
#DJANGO_STATIC_ROOT=/srv/django-blast/static
#DJANGO_STATIC_URL=/static/
#DJANGO_STATICFILES_STORAGE=whitenoise.storage.CompressedStaticFilesStorage
#DJANGO_SERVE_MEDIA=1

# --- Celery (task queue for BLAST jobs) ---
#CELERY_BROKER_URL=redis://localhost:6379/0
#CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
#CELERY_RESULT_BACKEND=
# Run BLAST jobs inside the web process instead of a worker (small setups, tests)
#CELERY_TASK_ALWAYS_EAGER=1

# --- BLAST+ ---
# Directory with blastn, makeblastdb, ... (default: PATH, then blast/bin_linux or blast/bin_win)
#BLAST_BIN_DIR=/usr/bin
#BLAST_NUM_THREADS=4
#BLAST_RESULT_RETENTION_DAYS=7
#BLAST_REMOVE_EXPIRED_FILES=0

# --- Cache (queue position on the results page) ---
#USE_CACHE=1
#CACHE_URL=redis://localhost:6379/1

# --- Login ---
#LOGIN_ENABLED=1
#SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
#SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
#SOCIAL_AUTH_FACEBOOK_KEY=
#SOCIAL_AUTH_FACEBOOK_SECRET=

# --- i5k ---
#ANALYTICS_ENABLED=0
#WEBAPOLLO_COOKIE_DOMAIN=.nal.usda.gov

# --- E-mail ---
#DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=localhost
#EMAIL_PORT=1025
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=0
#DEFAULT_FROM_EMAIL=webmaster@localhost

# --- HTTPS (behind a TLS terminating proxy) ---
#DJANGO_SECURE_PROXY_SSL_HEADER=1
#DJANGO_SECURE_SSL_REDIRECT=1
#DJANGO_SESSION_COOKIE_SECURE=1
#DJANGO_CSRF_COOKIE_SECURE=1
#DJANGO_SECURE_HSTS_SECONDS=31536000
#DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
#DJANGO_SECURE_HSTS_PRELOAD=1
#DJANGO_X_FRAME_OPTIONS=SAMEORIGIN
